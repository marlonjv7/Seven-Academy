# Dependencies
node_modules/



# Build
dist/
dist-ssr/
build/

# Vite cache
.vite/

# Environment variables / secrets
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# Operating System
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.cache
.cache/
.temp/
tmp/

# Testing
coverage/
.nyc_output/

# Vercel
.vercel/

# Netlify (por si se usa posteriormente)
.netlify/

# Supabase local development
supabase/.temp/
supabase/.branches/

# TypeScript cache
*.tsbuildinfo

# ESLint cache
.eslintcache

# Parcel cache
.parcel-cache/

# Optional package manager caches
.npm/
.yarn/cache/
.yarn/unplugged/
.pnpm-store/

# Local certificates
*.pem
*.key
*.crt

# Backup files
*.bak
*.backup
